<article class="feature-card">
  <a class="card-image-link" href="<%= service.path %>" tabindex="-1" aria-hidden="true"><img class="service-image" src="<%= service.image %>" alt="<%= service.imageAlt %>" width="1024" height="683" loading="lazy" decoding="async" /></a>
  <div class="card-body"><h3><a href="<%= service.path %>"><%= service.title %></a></h3><p><%= service.summary %></p><a class="text-link card-link" href="<%= service.path %>" aria-label="Explore <%= service.title %>">Explore service</a></div>
</article>
