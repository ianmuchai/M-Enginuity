<%- include('partials/head', { title, description }) %>
<%- include('partials/header', { activePage }) %>
      <main id="main-content">
        <section class="page-banner">
          <div class="container">
            <p class="eyebrow">Contact</p>
            <h1>Talk to M-Enginuity</h1>
            <p>Contact us about engineering, plant and workshop requirements.</p>
          </div>
        </section>
        <section class="section">
          <div class="container contact-page-layout">
            <div class="contact-details">
              <p class="eyebrow">Reach our team</p>
              <h2>Get in touch</h2>
              <ul class="footer-meta">
                <li><a href="mailto:info@menginuity.co.ke">info@menginuity.co.ke</a></li>
                <li><a href="mailto:info.menginuity@gmail.com">info.menginuity@gmail.com</a></li>
                <li><a href="tel:+254727444301">+254 727 444 301</a></li>
                <li><a href="tel:+254722318226">+254 722 318 226</a></li>
                <li>Along Namanga Road, Athi River, Kenya</li>
                <li>P.O. Box 599–00204</li>
                <li>Mon–Fri 08:00–17:00 · Sat 09:00–14:00</li>
              </ul>
            </div>
            <div class="contact-panel">
              <h2>Request a quote</h2>
              <form id="contact-form" class="contact-form">
                <label>Name<input type="text" name="name" placeholder="Your full name" autocomplete="name" maxlength="120" required /></label>
                <label>Email<input type="email" name="email" placeholder="you@company.com" autocomplete="email" maxlength="254" required /></label>
                <label>Project brief<textarea name="brief" placeholder="Tell us about the equipment, parts or support you need." rows="5" maxlength="5000" required></textarea></label>
                <label class="honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                <p class="form-note" role="status" aria-live="polite">We will respond using the email address you provide.</p>
                <button class="btn btn-primary" type="submit">Send inquiry</button>
              </form>
            </div>
          </div>
        </section>
      </main>
<%- include('partials/footer') %>
